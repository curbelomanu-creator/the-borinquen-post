---
layout: null
permalink: /search-index.json
---
[
{% for post in site.posts %}
  {% assign search_image = post.web_image | default: post.image | default: post.featured_image | default: post.thumbnail | default: post.cover | default: '/assets/images/default.jpg' %}
  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "category": {{ post.category | default: '' | jsonify }},
    "date": {{ post.date | date: '%Y-%m-%d' | jsonify }},
    "excerpt": {{ post.excerpt | strip_html | strip_newlines | truncate: 220 | jsonify }},
    "content": {{ post.content | strip_html | strip_newlines | jsonify }},
    "tags": {{ post.tags | jsonify }},
    "image": {{ search_image | relative_url | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
